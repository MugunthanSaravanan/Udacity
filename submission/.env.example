# User-reported Vocareum project configuration; confirm project in the lab UI.
GOOGLE_CLOUD_PROJECT=lab18633938-1795419661
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash-lite

# Prefer credentials already provided by the Vocareum Cloud Shell environment.
# Do not create or commit a service-account key for this project.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/path/to/lab-service-account.json

# Vertex AI Search. Search location is independent of Gemini's global location.
# Fill these from the existing/created search data store in the lab project.
VERTEX_AI_SEARCH_PROJECT_ID=lab18633938-1795419661
VERTEX_AI_SEARCH_LOCATION=your-search-location
VERTEX_AI_SEARCH_DATASTORE_ID=your-datastore-id
VERTEX_AI_SEARCH_SERVING_CONFIG=default_config

# MCP Toolbox / Cloud SQL for MySQL; values must come from an existing instance.
CLOUD_SQL_MYSQL_PROJECT=lab18633938-1795419661
CLOUD_SQL_MYSQL_REGION=your-cloud-sql-region
CLOUD_SQL_MYSQL_INSTANCE=your-cloud-sql-instance
CLOUD_SQL_MYSQL_DATABASE=betty
CLOUD_SQL_MYSQL_USER=your-read-only-database-user
CLOUD_SQL_MYSQL_PASSWORD=replace-with-your-own-secret
TOOLBOX_URL=http://127.0.0.1:5000
